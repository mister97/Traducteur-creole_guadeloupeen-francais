# Copier en .env.local (développement) ou saisir dans Plesk > Node.js > Variables d'environnement.

# --- Base MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=mofwaze
DB_PASSWORD=
DB_NAME=mofwaze
# ou, à la place : DATABASE_URL=mysql://utilisateur:motdepasse@localhost:3306/mofwaze

# --- Site ---
SITE_URL=https://mofwazajkreyolgwadloupeyen.fr
CONTACT_EMAIL=kontakt@mofwazajkreyolgwadloupeyen.fr

# --- Admin ---
# Générer avec : npm run admin:hash -- "votre mot de passe"
ADMIN_PASSWORD_HASH=
# Chaîne aléatoire d'au moins 32 caractères (également fournie par admin:hash)
SESSION_SECRET=

# --- Mails (SMTP OVH) ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=kontakt@mofwazajkreyolgwadloupeyen.fr
SMTP_PASS=
MAIL_FROM=Mofwazé <kontakt@mofwazajkreyolgwadloupeyen.fr>
# Adresse qui reçoit les nouvelles suggestions (par défaut CONTACT_EMAIL)
ADMIN_EMAIL=kontakt@mofwazajkreyolgwadloupeyen.fr
