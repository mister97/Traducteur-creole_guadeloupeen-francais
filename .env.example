# Copier en .env.local (développement) ou saisir dans Plesk > Node.js > Variables d'environnement.

# --- Base MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=chalviraj
DB_PASSWORD=
DB_NAME=chalviraj
# ou, à la place : DATABASE_URL=mysql://utilisateur:motdepasse@localhost:3306/chalviraj

# --- Site ---
SITE_URL=https://chalviraj.com
CONTACT_EMAIL=kontakt@chalviraj.com

# --- Sessions ---
# Chaîne aléatoire d'au moins 32 caractères : « npm run secret ».
# Signe les cookies d'administration et d'espace partenaire. La changer
# déconnecte tout le monde. Ne jamais la mettre dans le dépôt.
SESSION_SECRET=

# --- Avant-lancement ---
# Tant que cette date n'est pas passée, le site public affiche un décompte.
# L'administration reste accessible, et une personne connectée voit le site
# normalement. Laissez vide pour qu'il n'y ait aucun rideau.
# Le rideau se lève tout seul à la date indiquée : rien à faire le jour J.
# DATE_LANCEMENT=2026-10-28T00:00:00-04:00

# --- Administration ---
# Il n'y a pas de mot de passe dans la configuration : chaque personne a son
# compte, créé avec « npm run admin:creer » puis depuis /admin/utilisateurs.

# --- Mails (SMTP OVH) ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=kontakt@chalviraj.com
SMTP_PASS=
MAIL_FROM=Chalviraj <kontakt@chalviraj.com>
# Adresse qui reçoit les nouvelles suggestions (par défaut CONTACT_EMAIL)
ADMIN_EMAIL=kontakt@chalviraj.com

# --- API publique et espace partenaire ---
# Décompte des quotas en base, utile seulement si plusieurs instances Node tournent (0 ou 1)
API_QUOTA_BASE=0
